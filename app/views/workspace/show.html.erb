<main class="workspace-shell">
  <header class="workspace-topbar">
    <%= link_to "Insurr<span>Brdge</span>".html_safe, root_path, class: "brand" %>
    <nav class="workspace-user"><%= link_to "Customers", customers_path, class: "text-button" %></nav>
    <div class="workspace-user">
      <span><%= current_agency.name %></span>
      <span class="user-initial"><%= current_user.first_name.to_s.first || current_user.email.first.upcase %></span>
      <%= button_to "Sign out", sign_out_path, method: :delete, class: "text-button" %>
    </div>
  </header>
  <section class="workspace-heading">
    <div><p class="eyebrow">AGENCY WORKSPACE</p><h1>Good to see you, <%= current_user.first_name.presence || "there" %>.</h1><p class="hero-copy">Your commercial insurance operation, in one place.</p></div>
    <span class="environment-pill">AGENCY · <%= current_membership.role.humanize.upcase %></span>
  </section>
  <section class="metric-grid">
    <article><span>CLIENT ACCOUNTS</span><strong><%= @customer_count %></strong><small>Businesses in your agency</small></article>
    <article><span>SUBMISSIONS</span><strong><%= @submission_count %></strong><small>All lines of business</small></article>
    <article><span>QUOTES RECEIVED</span><strong><%= @quote_count %></strong><small>Carrier-returned quote records</small></article>
    <article><span>AVAILABLE MARKETS</span><strong><%= @carrier_count %></strong><small>Sandbox or live adapters only</small></article>
  </section>
  <section class="workspace-panels">
    <article class="workspace-panel"><div class="panel-heading"><div><p class="eyebrow">RECENT ACTIVITY</p><h2>Latest submissions</h2></div></div>
      <% if @submissions.any? %>
        <div class="data-list"><% @submissions.each do |submission| %><div class="data-row"><div><strong><%= submission.customer.legal_name %></strong><small><%= submission.reference %> · <%= submission.line_of_business.humanize %></small></div><span class="status-pill"><%= submission.status.humanize %></span></div><% end %></div>
      <% else %><p class="empty-state">Your submissions will appear here once you create your first account and application.</p><% end %>
    </article>
    <article class="workspace-panel"><p class="eyebrow">YOUR AGENCY</p><h2><%= current_agency.name %></h2><p class="panel-copy">Your agency data is isolated from every other InsurrBrdge tenant. Team invitations, customer records and carrier submissions will be managed here.</p><div class="security-note"><strong>Workspace security</strong><span>Signed in as <%= current_user.email %></span><span>Role: <%= current_membership.role.humanize %></span></div></article>
  </section>
  <footer>InsurrBrdge · One Submission. Multiple Carriers. Smarter Decisions.</footer>
</main>
