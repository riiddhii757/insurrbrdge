<main class="workspace-shell">
  <header class="workspace-topbar"><%= link_to "Insurr<span>Brdge</span>".html_safe, workspace_path, class: "brand" %><nav class="workspace-user"><%= link_to "All applications", insurance_submissions_path, class: "text-button" %><%= link_to "Customers", customers_path, class: "text-button" %><%= button_to "Sign out", sign_out_path, method: :delete, class: "text-button" %></nav></header>
  <section class="workspace-heading">
    <div><p class="eyebrow">APPLICATION · <%= @submission.reference %></p><h1><%= @submission.customer.legal_name %></h1><p class="hero-copy"><%= @submission.line_of_business.humanize %> · <%= @submission.state.presence || "State not set" %> · Effective <%= @submission.effective_date&.to_fs(:long) || "Not set" %></p></div>
    <% if current_membership.role != "read_only" && %w[draft ready].include?(@submission.status) %>
      <%= link_to "Edit application", edit_insurance_submission_path(@submission), class: "secondary-button" %>
      <%= button_to "Submit to configured markets", submit_insurance_submission_path(@submission), method: :post, class: "primary-button" %>
    <% end %>
  </section>
  <section class="workspace-panels">
    <article class="workspace-panel">
      <p class="eyebrow">APPLICATION DETAILS</p><h2>Placement summary</h2>
      <div class="detail-list">
        <div><span>Customer</span><strong><%= @submission.customer.legal_name %></strong></div>
        <div><span>Reference</span><strong><%= @submission.reference %></strong></div>
        <div><span>Line</span><strong><%= @submission.line_of_business.humanize %></strong></div>
        <div><span>State</span><strong><%= @submission.state.presence || "—" %></strong></div>
        <div><span>Effective date</span><strong><%= @submission.effective_date&.to_fs(:long) || "—" %></strong></div>
        <div><span>Expiration date</span><strong><%= @submission.expiration_date&.to_fs(:long) || "—" %></strong></div>
        <div><span>Workflow status</span><strong><%= @submission.status.humanize %></strong></div>
      </div>
      <% if @submission.business_details.present? || @submission.exposures.present? || @submission.requested_coverages.present? %>
        <p class="eyebrow">RISK PROFILE</p>
        <div class="detail-list">
          <% @submission.business_details.each do |key, value| %><% if value.present? %><div><span><%= key.humanize %></span><strong><%= value %></strong></div><% end %><% end %>
          <% @submission.exposures.each do |key, value| %><% if value.present? %><div><span><%= key.humanize %></span><strong><%= value %></strong></div><% end %><% end %>
          <% @submission.requested_coverages.each do |key, value| %><% if value.present? %><div><span><%= key.humanize %></span><strong><%= value %></strong></div><% end %><% end %>
        </div>
      <% end %>
      <% if @submission.underwriter_notes.present? %><p class="eyebrow">BROKER NOTES</p><p><%= @submission.underwriter_notes %></p><% end %>
    </article>
    <article class="workspace-panel">
      <p class="eyebrow">MARKET RESPONSES</p><h2><%= @market_submissions.size %> market attempts</h2>
      <% if @market_submissions.any? %>
        <div class="data-list">
          <% @market_submissions.each do |market| %>
            <div class="data-row"><div><strong><%= market.carrier.name %></strong><small><%= market.environment.upcase %> · <%= market.response_metadata["message"].presence || market.failure_reason.presence || "Awaiting response" %></small><small>Submitted <%= market.submitted_at&.to_fs(:long) || "Not recorded" %> · Responded <%= market.responded_at&.to_fs(:long) || "Pending" %></small></div><span class="status-pill"><%= market.status.humanize %></span></div>
          <% end %>
        </div>
      <% else %><p class="empty-state">No markets have been contacted. Complete the risk state and effective date, then submit the application.</p><% end %>
      <p class="legal-note">Appetite screening is not a quote. Demo or sandbox activity is not a real insurance offer and cannot bind coverage.</p>
    </article>
  </section>
  <% if @quotes.any? %>
    <section class="workspace-panel quote-comparison">
      <p class="eyebrow">CARRIER-RETURNED OFFERS</p><h2>Quote comparison</h2>
      <div class="quote-table-wrap">
        <table class="quote-table">
          <thead><tr><th>Market</th><th>Source</th><th>Premium</th><th>Fees</th><th>Taxes</th><th>Total</th><th>Effective</th><th>Expires</th></tr></thead>
          <tbody>
            <% @quotes.each do |quote| %>
              <% unit = quote.currency == "USD" ? "$" : "#{quote.currency} " %>
              <% total = [quote.premium, quote.fees, quote.taxes].compact.sum %>
              <tr>
                <td><strong><%= quote.market_submission.carrier.name %></strong><small><%= quote.status.humanize %></small></td>
                <td><%= quote.source.upcase %> · <%= quote.environment.upcase %></td>
                <td><%= quote.premium.present? ? number_to_currency(quote.premium, unit: unit) : "—" %></td>
                <td><%= quote.fees.present? ? number_to_currency(quote.fees, unit: unit) : "—" %></td>
                <td><%= quote.taxes.present? ? number_to_currency(quote.taxes, unit: unit) : "—" %></td>
                <td><strong><%= quote.premium.present? ? number_to_currency(total, unit: unit) : "—" %></strong></td>
                <td><%= quote.effective_date&.to_fs(:short) || "—" %></td>
                <td><%= quote.expires_at&.to_fs(:short) || "—" %></td>
              </tr>
              <% if quote.coverages.present? || quote.conditions.present? || quote.exclusions.present? %>
                <tr class="quote-terms"><td colspan="8">
                  <% if quote.coverages.present? %><span>Coverages: <%= quote.coverages.map { |key, value| "#{key.humanize}: #{value}" }.join(" · ") %></span><% end %>
                  <% if quote.conditions.present? %><span>Conditions: <%= Array(quote.conditions).join(", ") %></span><% end %>
                  <% if quote.exclusions.present? %><span>Exclusions: <%= Array(quote.exclusions).join(", ") %></span><% end %>
                </td></tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="legal-note">Compare only the carrier/aggregator source, currency, limits, conditions and exclusions supplied with each quote. A sandbox or demo quote is not a bindable offer.</p>
    </section>
  <% end %>
</main>
